{
  "name": "kosha",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,yml,yaml,css}\"",
    "check-env": "pnpm --filter @kosha/scripts exec tsx check-env.ts",
    "bootstrap": "pnpm --filter @kosha/scripts exec tsx bootstrap.ts",
    "seed": "pnpm --filter @kosha/scripts exec tsx seed.ts",
    "register-agents": "pnpm --filter @kosha/scripts exec tsx register-agents.ts",
    "smoke-settle": "pnpm --filter @kosha/scripts exec tsx smoke-settle.ts",
    "smoke-compat": "pnpm --filter @kosha/scripts exec tsx smoke-compat.ts",
    "pay-once": "pnpm --filter @kosha/scripts exec tsx pay-once.ts",
    "burst": "pnpm --filter @kosha/scripts exec tsx burst.ts",
    "demo": "pnpm --filter @kosha/scripts exec tsx demo.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
