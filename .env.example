# Kosha environment. Start with `cp .env.example .env`, then fill in the Hedera operator account;
# `pnpm bootstrap` writes most of the remaining values. `.env.local` (gitignored) overrides `.env`.
# Run `pnpm check-env` to see which keys are still empty. Never commit real values.

# --- Hedera ---
HEDERA_NETWORK=testnet
MIRROR_URL=https://testnet.mirrornode.hedera.com
# Fee payer and facilitator account (portal.hedera.com)
CORE_ACCOUNT_ID=
CORE_PRIVATE_KEY=
# Written by `pnpm bootstrap`
SETTLEMENT_TOKEN_ID=
COMPLIANCE_ACCOUNT_ID=
COMPLIANCE_PRIVATE_KEY=
# payTo of the x402 `exact` compatibility entry; Core forwards the price from it
COMPAT_SETTLEMENT_ACCOUNT_ID=
# 2-of-2 (Core + compliance): TDS from compatibility-mode payments, booked per payer
POOL_RESERVE_ACCOUNT_ID=
# Every Kosha topic has Core as its submit key
HCS_PAYMENTS_TOPIC=
HCS_PROFILES_TOPIC=
# The Agent Kit's HcsAuditTrailHook writes here
HCS_AUDIT_TOPIC=
# Upper bound on the fee Core will pay for one settlement
MAX_TX_FEE_HBAR=2

# --- Core ---
CORE_PORT=4000
CORE_URL=http://localhost:4000
DATABASE_URL=postgres://postgres:kosha@localhost:5432/kosha
RULEPACK_PATH=rulepacks/in-2026.2.json
FX_SOURCE=demo-fixed
FX_DEMO_INR_PER_USD=88.40
# Secrets, generated by `pnpm bootstrap`
PAIR_HMAC_SECRET=
PAN_COMMIT_SECRET=
ISSUER_PRIVATE_KEY=
CONSOLE_ADMIN_TOKEN=

# --- Demo receivers (API keys Core issues to the demo APIs; generated by `pnpm bootstrap`) ---
DEMO_API_IN_KEY=
DEMO_API_GLOBAL_KEY=

# --- Demo agent ---
# anthropic or openai, with the matching key
LLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Agent B ---
# Agent B adds its keys below this line only.
# Demo APIs (B06); only Agent B runs them (PROTOCOL §10)
DEMO_API_IN_PORT=4101
DEMO_API_GLOBAL_PORT=4102
# off skips Gate's Mirror Node reserve proof; `pnpm burst` starts its own API this way (B17)
DEMO_API_PROOF=on
# The demo APIs' terms link here for Level 1 registration
CONSOLE_URL=http://localhost:3000
# Console: 1 shows the demo workspace picker and keeps each role in its workspace
DEMO_AUTH=1
# Core's INR rate from the kosha-fx Chainlink CRE workflow (cre/README.md). Unset keeps
# FX_DEMO_INR_PER_USD. simulation: accept `cre workflow simulate` reports from this machine.
# signers: a deployed DON's signer addresses in CRE_FX_SIGNERS (comma-separated).
CRE_FX_TRUST=
CRE_FX_SIGNERS=
# Written by `pnpm bootstrap` (B03); Agent A's seed reads these names. Each agent's reserve is a
# 2-of-2 (agent + Core); see docs/testnet-accounts.md for the IDs.
RECEIVER_IN_ACCOUNT_ID=
RECEIVER_IN_PRIVATE_KEY=
RECEIVER_IN_SOLO_ACCOUNT_ID=
RECEIVER_IN_SOLO_PRIVATE_KEY=
RECEIVER_GLOBAL_ACCOUNT_ID=
RECEIVER_GLOBAL_PRIVATE_KEY=
AGENT_RESIDENT_ACCOUNT_ID=
AGENT_RESIDENT_PRIVATE_KEY=
AGENT_RESIDENT_RESERVE_ID=
AGENT_NONRESIDENT_ACCOUNT_ID=
AGENT_NONRESIDENT_PRIVATE_KEY=
AGENT_NONRESIDENT_RESERVE_ID=
AGENT_UNKNOWN_ACCOUNT_ID=
AGENT_UNKNOWN_PRIVATE_KEY=
AGENT_UNKNOWN_RESERVE_ID=
# Written by `pnpm bootstrap`: the account whose key is the audit topic's submit key. The demo
# agent's HcsAuditTrailHook posts with it, so the agent never holds Core's key.
AUDIT_ACCOUNT_ID=
AUDIT_PRIVATE_KEY=
# Written by `pnpm register-agents` (B23): each Level 1 demo agent's HCS-14 UAID and the HCS-1
# topic holding its HCS-11 profile
AGENT_RESIDENT_UAID=
AGENT_RESIDENT_PROFILE_TOPIC=
AGENT_NONRESIDENT_UAID=
AGENT_NONRESIDENT_PROFILE_TOPIC=
# Console (B10): 1 serves @kosha/shared fixtures and a fake event stream instead of calling Core
KOSHA_MOCK=
# The receiver the API-owner workspace shows. Mock mode uses rcv_in. Live, it is Core's internal
# receiver ID for receiver-in: the receiverId on its rows in GET /v1/ledger (admin token).
CONSOLE_RECEIVER_ID=
