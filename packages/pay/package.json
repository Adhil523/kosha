{
  "name": "@kosha/pay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./src/*.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "import": {
          "types": "./dist/kosha-pay.d.ts",
          "default": "./dist/kosha-pay.js"
        },
        "require": {
          "types": "./dist/kosha-pay.d.cts",
          "default": "./dist/kosha-pay.cjs"
        }
      },
      "./*": {
        "import": {
          "types": "./dist/*.d.ts",
          "default": "./dist/*.js"
        },
        "require": {
          "types": "./dist/*.d.cts",
          "default": "./dist/*.cjs"
        }
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@hiero-ledger/sdk": "2.90.1",
    "@x402/core": "2.30.0",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@hashgraph/hedera-agent-kit": "4.2.0"
  },
  "peerDependenciesMeta": {
    "@hashgraph/hedera-agent-kit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hashgraph/hedera-agent-kit": "4.2.0",
    "@kosha/hedera": "workspace:*",
    "@kosha/shared": "workspace:*",
    "@kosha/tax-engine": "workspace:*",
    "tsup": "8.5.1"
  }
}
